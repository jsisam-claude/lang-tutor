<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Merged into the main manifest for the FULL flavor only: these exist to
         let the language model's OpenCL GPU backend initialise, and the
         practice flavor has no language model (docs/practice-flavor.md). -->
    <application>
        <!-- Android 12+ (our minSdk) blocks vendor native libraries an app does
             not declare: dlopen("libOpenCL.so") fails with "not found" even
             when the driver exists. Without these, LiteRT-LM's OpenCL GPU
             backend can never initialize — the engine-create failure looks
             like a missing driver but is namespace isolation. Google's TFLite
             GPU docs name exactly these two; required=false keeps installs
             working on devices that genuinely lack them. -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL-pixel.so"
            android:required="false" />

    </application>
</manifest>
