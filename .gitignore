# Gradle / build
.gradle/
build/
**/build/
local.properties
.kotlin/

# IDE
.idea/
*.iml
captures/
.DS_Store

# Model weights are NEVER committed (delivered via Play Asset Delivery)
*.litertlm
*.task
*.onnx
*.gguf
*.tflite
asset-packs/*/src/main/assets/models/*
!asset-packs/*/src/main/assets/models/.gitkeep

# Python
__pycache__/
*.pyc

# sideload script output (multi-GB model downloads)
sideload/

# GPU sampler libs fetched by scripts/fetch-gpu-libs.sh (pinned SHA-256s
# in the script; never committed)
app/src/main/jniLibs/

# Tuki's voice asset fetched by scripts/fetch-voice-assets.sh (pinned SHA-256)
app/src/main/assets/kokoro/

# Hands-free VAD asset fetched by scripts/fetch-vad-asset.sh (pinned SHA-256)
app/src/main/assets/vad/
